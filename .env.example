GEMINI_API_KEY=your-paid-gemini-api-key-here

# YouTube Data API v3 key. Used for channel/video metadata (discovery,
# titles, durations). Free tier (10,000 units/day) is plenty for daily runs.
# Enable the API and create a key at:
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# Slack incoming webhook URL. Leave blank to skip Slack posting (the
# markdown files in output/ are still written either way).
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Base URL prepended to per-video links in the Slack digest. The script
# appends /<YYYY-MM-DD>/<video_id>.md to this. Until phase 3 (GitHub Pages),
# point this at the GitHub blob view of the working branch, e.g.:
#   https://github.com/jsierrahoopshype/hoopshype-yt-quotes/blob/claude/youtube-quote-extractor-pcYe7/output
# In phase 3 you'll swap this for the GitHub Pages URL.
OUTPUT_BASE_URL=
