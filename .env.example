GEMINI_API_KEY=your-paid-gemini-api-key-here

# Optional. When set, yt-dlp uses cookies from your local browser session to
# avoid YouTube's "sign in to confirm you're not a bot" check on per-video
# metadata lookups. Only needed when the RSS feed and the HTML scrape both
# fail to give a duration. Leave empty when running on GitHub Actions.
# Common values: chrome, firefox, edge, brave, safari, vivaldi
YTDLP_BROWSER=
